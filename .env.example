# Copy to .env.local (git-ignored) to override. Both variables are optional.
# These are build-time variables for the browser app (Vite). Worker/API
# variables live in wrangler.jsonc "vars" and .dev.vars (see .dev.vars.example).

# Display name shown in the header. Defaults to "Midnight Invoice".
VITE_APP_NAME="Midnight Invoice"

# One of DEVELOPMENT | STAGING | PREVIEW | PRODUCTION. Defaults to DEVELOPMENT,
# which shows the "Development Mode" banner and the dev favicon.
VITE_APP_ENV="DEVELOPMENT"
